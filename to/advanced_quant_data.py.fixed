        if not minute_df.empty and 'time_str' in minute_df.columns:
            time_counts = minute_df.groupby('time_str').size()
            logger.info("交易时段分布:")
            for time_str, count in time_counts.head(10).items():
                logger.info(f"  {time_str}: {count}条记录")
        
