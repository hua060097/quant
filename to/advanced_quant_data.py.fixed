                            'std': stock_data['volume'].std(),
                            'min': stock_data['volume'].min(),
                            'max': stock_data['volume'].max()
                        }
                        logger.info(f"  成交量统计: {volume_stats}")
        except Exception as e:
            logger.error(f"绘制K线图时出错: {e}")
            import traceback
            logger.error(traceback.format_exc())
    
